{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "matlistan chart values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "baseURL": {
      "type": "string",
      "anyOf": [
        {
          "const": ""
        },
        {
          "pattern": "^https://"
        }
      ]
    },
    "locale": {
      "enum": [
        "en",
        "sv"
      ]
    },
    "timezone": {
      "type": "string",
      "minLength": 1
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "urlSecret": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "caSecret": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "cnpg": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "instances": {
              "type": "integer",
              "minimum": 1
            },
            "storageClass": {
              "type": "string"
            },
            "size": {
              "type": "string",
              "pattern": "^[0-9]+(Mi|Gi|Ti)$"
            },
            "imageCatalog": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "major": {
                  "type": "integer"
                }
              }
            },
            "backup": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "barmanObjectName": {
                  "type": "string"
                }
              }
            },
            "podMonitor": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "oidc": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "issuer": {
          "type": "string"
        },
        "clientID": {
          "type": "string"
        },
        "clientSecret": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "caConfigMap": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "allowed": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "pattern": "^[^,]+$"
          }
        }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "keySecret": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "anthropic": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "apiKeySecret": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "model": {
          "type": "string"
        }
      }
    },
    "household": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "name",
              "birthYear"
            ],
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,59}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              },
              "birthYear": {
                "type": "integer",
                "minimum": 1900,
                "maximum": 2100
              },
              "diets": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "vegetarian",
                    "vegan",
                    "pescatarian",
                    "no_pork"
                  ]
                }
              },
              "allergens": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "gluten",
                    "crustaceans",
                    "eggs",
                    "fish",
                    "peanuts",
                    "soybeans",
                    "milk",
                    "nuts",
                    "celery",
                    "mustard",
                    "sesame",
                    "sulphites",
                    "lupin",
                    "molluscs"
                  ]
                }
              },
              "likes": {
                "type": "string",
                "maxLength": 500
              },
              "dislikes": {
                "type": "string",
                "maxLength": 500
              }
            }
          }
        },
        "recipes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "title",
              "servings",
              "totalMinutes",
              "steps",
              "ingredients"
            ],
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,59}$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "lang": {
                "type": "string",
                "enum": [
                  "en",
                  "sv"
                ]
              },
              "servings": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20
              },
              "activeMinutes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1440
              },
              "totalMinutes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1440
              },
              "description": {
                "type": "string",
                "maxLength": 1000
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 30
                }
              },
              "diets": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "vegetarian",
                    "vegan",
                    "pescatarian",
                    "no_pork"
                  ]
                }
              },
              "allergens": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "gluten",
                    "crustaceans",
                    "eggs",
                    "fish",
                    "peanuts",
                    "soybeans",
                    "milk",
                    "nuts",
                    "celery",
                    "mustard",
                    "sesame",
                    "sulphites",
                    "lupin",
                    "molluscs"
                  ]
                }
              },
              "sourceURL": {
                "type": "string",
                "pattern": "^(https://.*)?$"
              },
              "steps": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "ingredients": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name",
                    "section"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    },
                    "quantity": {
                      "type": "number",
                      "minimum": 0
                    },
                    "unit": {
                      "type": "string",
                      "enum": [
                        "g",
                        "kg",
                        "ml",
                        "dl",
                        "l",
                        "pcs",
                        "tbsp",
                        "tsp",
                        "pinch"
                      ]
                    },
                    "section": {
                      "type": "string",
                      "enum": [
                        "produce",
                        "dairy",
                        "meat_fish",
                        "pantry",
                        "frozen",
                        "bakery",
                        "other"
                      ]
                    },
                    "optional": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        },
        "recipeURLs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^https://"
          }
        }
      }
    },
    "push": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "vapidKeySecret": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string" },
            "key": { "type": "string", "minLength": 1 }
          }
        },
        "subject": { "type": "string", "pattern": "^(|mailto:.+|https://.+)$" }
      }
    },
    "generate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "schedule": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "resources": {
      "type": "object"
    },
    "httpRoute": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "parentRefs": {
          "type": "array"
        },
        "hostnames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "gateway": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "namespaceSelector": {
              "type": "object"
            },
            "podSelector": {
              "type": "object"
            }
          }
        },
        "metricsScraper": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "namespaceSelector": {
              "type": "object"
            },
            "podSelector": {
              "type": "object"
            }
          }
        },
        "dns": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "namespaceSelector": {
              "type": "object"
            },
            "podSelector": {
              "type": "object"
            }
          }
        },
        "database": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "namespaceSelector": {
              "type": "object"
            },
            "podSelector": {
              "type": "object"
            },
            "port": {
              "type": "integer"
            }
          }
        },
        "https": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cidrs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "port": {
              "type": "integer"
            }
          }
        },
        "llm": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cidrs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "port": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "light": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
          },
          "propertyNames": {
            "enum": [
              "page",
              "panel",
              "line",
              "ink",
              "muted",
              "focus",
              "primary",
              "primaryInk",
              "attention",
              "attentionText",
              "day1",
              "day2",
              "day3",
              "day4",
              "day5",
              "day6",
              "day7",
              "day1Ink",
              "day2Ink",
              "day3Ink",
              "day4Ink",
              "day5Ink",
              "day6Ink",
              "day7Ink"
            ]
          }
        },
        "dark": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
          },
          "propertyNames": {
            "enum": [
              "page",
              "panel",
              "line",
              "ink",
              "muted",
              "focus",
              "primary",
              "primaryInk",
              "attention",
              "attentionText",
              "day1",
              "day2",
              "day3",
              "day4",
              "day5",
              "day6",
              "day7",
              "day1Ink",
              "day2Ink",
              "day3Ink",
              "day4Ink",
              "day5Ink",
              "day6Ink",
              "day7Ink"
            ]
          }
        }
      }
    },
    "global": {
      "type": "object"
    },
    "llm": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "enum": [
            "anthropic",
            "openai"
          ]
        },
        "model": {
          "type": "string"
        },
        "baseURL": {
          "type": "string",
          "pattern": "^$|^https?://"
        },
        "apiKeySecret": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "maxOutputTokens": {
          "type": "integer",
          "anyOf": [
            {
              "const": 0
            },
            {
              "minimum": 1024
            }
          ]
        }
      }
    }
  }
}
