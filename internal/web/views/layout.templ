package views

import "github.com/jalet/matlistan/internal/i18n"

templ Layout(title, active string) {
	<!DOCTYPE html>
	<html lang={ string(i18n.From(ctx).Locale()) }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="description" content={ i18n.T(ctx, "app.description") }/>
			<meta name="theme-color" content="#eef2f6" media="(prefers-color-scheme: light)"/>
			<meta name="theme-color" content="#0d1b2a" media="(prefers-color-scheme: dark)"/>
			<meta name="apple-mobile-web-app-capable" content="yes"/>
			<meta name="apple-mobile-web-app-title" content={ i18n.T(ctx, "app.name") }/>
			<link rel="manifest" href="/manifest.webmanifest"/>
			<link rel="apple-touch-icon" href="/static/icons/icon-180.png"/>
			<meta name="htmx-config" content='{"includeIndicatorStyles":false}'/>
			<title>{ title } - { i18n.T(ctx, "app.name") }</title>
			<link rel="stylesheet" href="/static/app.css"/>
			<link rel="stylesheet" href="/static/theme.css"/>
			<script src="/static/htmx.min.js" defer></script>
		</head>
		<body>
			<div class="pb-24">
				{ children... }
			</div>
			@nav(active)
		</body>
	</html>
}

templ nav(active string) {
	<nav class="fixed inset-x-0 bottom-0 border-t border-line bg-panel" aria-label={ i18n.T(ctx, "nav.label") }>
		<ul class="mx-auto flex max-w-md justify-around">
			@navItem("/week", i18n.T(ctx, "nav.week"), active == "week")
			@navItem("/shopping", i18n.T(ctx, "nav.shopping"), active == "shopping")
			@navItem("/recipes", i18n.T(ctx, "nav.recipes"), active == "recipes")
			@navItem("/family", i18n.T(ctx, "nav.family"), active == "family")
			@navItem("/settings", i18n.T(ctx, "nav.settings"), active == "settings")
		</ul>
	</nav>
}

templ navItem(href, label string, current bool) {
	<li>
		if current {
			<a href={ templ.URL(href) } aria-current="page" class="block px-3 py-4 font-bold text-ink">{ label }</a>
		} else {
			<a href={ templ.URL(href) } class="block px-3 py-4 text-muted">{ label }</a>
		}
	</li>
}
