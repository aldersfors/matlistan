# Copy to .env and fill in. Keep .env out of git: it holds the database password.

# Where people open Matlistan. https, except http://localhost for a try-out.
MATLISTAN_BASE_URL=https://matlistan.example.com
# Published on 127.0.0.1 only; point your reverse proxy here.
MATLISTAN_PORT=8080

# A long random password, for example: openssl rand -hex 24
DB_PASSWORD=

# Your OpenID Connect provider. The client's redirect URI is MATLISTAN_BASE_URL/auth/callback.
OIDC_ISSUER=https://id.example.com
OIDC_CLIENT_ID=matlistan
# Who may sign in: one of these values must be in the ID token's OIDC_CLAIM.
OIDC_CLAIM=groups
OIDC_ALLOWED=family

# Who plans the weeks: anthropic, or openai (LLM_MODEL required). LLM_BASE_URL points
# openai at a compatible server such as Ollama, LiteLLM or vLLM.
LLM_PROVIDER=anthropic
LLM_MODEL=
LLM_BASE_URL=

MATLISTAN_LOCALE=en
MATLISTAN_TIMEZONE=UTC
